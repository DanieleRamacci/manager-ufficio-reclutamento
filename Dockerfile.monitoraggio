FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8081 \
    DATA_DIR=/data

WORKDIR /app

COPY requirements-monitoraggio-prod.txt /app/requirements-monitoraggio-prod.txt
RUN pip install --no-cache-dir -r /app/requirements-monitoraggio-prod.txt \
    && useradd --create-home --uid 10001 app \
    && mkdir -p /data \
    && chown app:app /data

COPY auth.py /app/auth.py
COPY *.html /app/
COPY monitoraggio/ /app/monitoraggio/

USER app
EXPOSE 8081

CMD ["sh", "-c", "exec gunicorn --bind 0.0.0.0:${PORT:-8081} --workers 1 --threads 4 --timeout 120 monitoraggio.wsgi:app"]
